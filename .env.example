# Postgres connection string. The compose file sets its own.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webhook_inbox

# Where the demo targets live (the echo-sink binary).
SINK_URL=http://127.0.0.1:8021

# Protects /ui. Generate one with: openssl rand -hex 32
# With no value the UI answers 503.
ADMIN_TOKEN=

# One secret per source in inbox.toml. Generate with: openssl rand -hex 32
# They must be set or the config will not load.
GITHUB_WEBHOOK_SECRET=
MIDTRANS_SERVER_KEY=
XENDIT_CALLBACK_TOKEN=
PARTNER_SECRET=

# Optional
# INBOX_CONFIG=inbox.toml
# RUST_LOG=info
# One access log line per received request (status and time):
# RUST_LOG=info,sqlx=warn,tower_http=debug
# Moves the published Postgres port when you already have one on 5432.
# DB_PORT=5432
